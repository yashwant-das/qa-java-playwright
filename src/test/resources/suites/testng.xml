<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Main TestNG Suite Configuration
    This suite runs all example tests in the framework.

    Listeners:
    - ScreenshotListener: Automatically captures screenshots on test failure
    - TestConfigurationListener: Configures suite parameters and parallel execution from YAML config
    - RetryListener: Handles test retry mechanism based on configuration

    Usage:
    - Run via Maven: mvn test
    - Run via IDE: Right-click on this file and select "Run"
    - Environment can be set via system property: -Denvironment=qa (default: qa)
-->
<suite name="Web Playwright Java Framework Test Suite" verbose="2">
    <listeners>
        <listener class-name="com.qaframework.playwright.listeners.ScreenshotListener"/>
        <listener class-name="com.qaframework.playwright.listeners.TestConfigurationListener"/>
        <listener class-name="com.qaframework.playwright.listeners.RetryListener"/>
    </listeners>

    <!-- Unit tests for the framework itself (no browser needed) -->
    <test name="Framework Unit Tests">
        <classes>
            <class name="com.qaframework.playwright.util.ConfigReaderOverrideTest"/>
        </classes>
    </test>

    <!-- Run all example tests demonstrating framework capabilities -->
    <test name="All Example Tests">
        <packages>
            <package name="com.qaframework.playwright.examples.*"/>
        </packages>
    </test>
</suite>
