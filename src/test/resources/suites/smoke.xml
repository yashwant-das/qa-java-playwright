<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Controlled browser smoke">
    <listeners>
        <listener class-name="com.qaframework.playwright.listeners.TestConfigurationListener"/>
        <listener class-name="com.qaframework.playwright.listeners.RetryListener"/>
    </listeners>
    <test name="Local form and context isolation">
        <classes>
            <class name="com.qaframework.playwright.smoke.BrowserSmokeTest"/>
        </classes>
    </test>
</suite>
